---
/**
 * The full symbol gallery.
 *
 * Deliberately NOT inlining the SVGs. At 6,551 symbols averaging 421 bytes
 * that is 2.6 MB of markup in one page, and the equivalent page in road-signs
 * reached 36 MB gzipped before anyone noticed. Instead each cell is an
 * <img loading="lazy"> pointing at a file copied from @bci-av/assets, so the
 * HTML stays small and the browser only fetches what scrolls into view.
 *
 * Filtering is client-side over the rendered cells, which needs no index and
 * no JavaScript framework.
 */
import { symbols } from '@bci-av/core';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Bliss encodes part of speech as the colour a symbol is drawn on, so these
// double as the legend.
const groups = [...new Set(symbols.map((s) => s.pos))].filter(Boolean).sort();
const counts = Object.fromEntries(
  groups.map((g) => [g, symbols.filter((s) => s.pos === g).length]),
);
---

<div class="bliss-gallery">
  <div class="controls">
    <input type="search" id="bliss-filter" placeholder={`Search ${symbols.length.toLocaleString()} symbols…`} aria-label="Filter symbols" />
    <select id="bliss-pos" aria-label="Filter by part of speech">
      <option value="">All parts of speech</option>
      {groups.map((g) => <option value={g}>{g} ({counts[g]})</option>)}
    </select>
    <span id="bliss-count" class="count">{symbols.length.toLocaleString()} shown</span>
  </div>

  <ul class="grid">
    {
      symbols.map((s) => (
        <li
          class="cell"
          data-search={`${s.synonyms.join(' ')} ${s.bciAv}`.toLowerCase()}
          data-pos={s.pos}
        >
          <img src={`${base}/symbols/${s.id}.svg`} alt={s.gloss} width="64" height="64" loading="lazy" />
          <code>{s.gloss}</code>
          <small>{s.bciAv}</small>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .controls {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .controls input[type='search'] {
    flex: 1 1 16rem;
    padding: 0.4rem 0.6rem;
  }
  .count {
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.75rem;
  }
  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    text-align: center;
  }
  .cell img {
    background: #fff;
    border-radius: 0.2rem;
  }
  .cell code {
    font-size: 0.7rem;
    word-break: break-word;
  }
  .cell small {
    font-size: 0.65rem;
    opacity: 0.6;
  }
  .cell[hidden] {
    display: none;
  }
</style>

<script>
  const filter = document.getElementById('bliss-filter') as HTMLInputElement | null;
  const pos = document.getElementById('bliss-pos') as HTMLSelectElement | null;
  const count = document.getElementById('bliss-count');
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.bliss-gallery .cell'));

  const apply = () => {
    const q = (filter?.value ?? '').trim().toLowerCase();
    const p = pos?.value ?? '';
    let shown = 0;
    for (const cell of cells) {
      const matches =
        (!q || (cell.dataset.search ?? '').includes(q)) && (!p || cell.dataset.pos === p);
      cell.hidden = !matches;
      if (matches) shown++;
    }
    if (count) count.textContent = `${shown.toLocaleString()} shown`;
  };

  filter?.addEventListener('input', apply);
  pos?.addEventListener('change', apply);
</script>
