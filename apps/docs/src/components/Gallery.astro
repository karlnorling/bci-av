---
/**
 * The symbol gallery.
 *
 * Two constraints pull against each other here: the vocabulary has 6,551
 * symbols, and the page should be usable on a phone.
 *
 * Rendering every cell server-side — the first version of this — produced
 * 26,441 DOM elements and a filter that walked all 6,551 cells on each
 * keystroke. The payload was fine (186 KB gzipped) but the DOM was not.
 *
 * So one page is rendered server-side, which keeps the gallery working without
 * JavaScript, and the rest are appended from a compact index
 * (public/symbol-index.json, ~90 KB gzipped against 1.9 MB of markup) as the
 * reader scrolls. Filtering runs over that index rather than over the DOM, so
 * it stays responsive across the whole vocabulary rather than just the
 * rendered page.
 *
 * The images are still lazy: inlining the SVGs is what made the equivalent
 * road-signs page 36 MB.
 */
import { symbols } from '@bci-av/core';

/** Cells rendered server-side, and appended per batch thereafter. */
const PAGE_SIZE = 200;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const firstPage = symbols.slice(0, PAGE_SIZE);

// Bliss encodes part of speech as the colour a symbol is drawn on, so these
// double as the legend.
const groups = [...new Set(symbols.map((s) => s.pos))].filter(Boolean).sort();
const counts = Object.fromEntries(groups.map((g) => [g, symbols.filter((s) => s.pos === g).length]));
---

<div class="bliss-gallery" data-base={base} data-page-size={PAGE_SIZE}>
  <div class="controls">
    <input
      type="search"
      id="bliss-filter"
      placeholder={`Search ${symbols.length.toLocaleString()} symbols…`}
      aria-label="Filter symbols"
      aria-controls="bliss-grid"
    />
    <select id="bliss-pos" aria-label="Filter by part of speech">
      <option value="">All parts of speech</option>
      {groups.map((g) => <option value={g}>{g} ({counts[g]})</option>)}
    </select>
    <span id="bliss-count" class="count" role="status">
      {symbols.length.toLocaleString()} symbols
    </span>
  </div>

  <ul class="grid" id="bliss-grid">
    {
      firstPage.map((s) => (
        <li class="cell">
          <img src={`${base}/symbols/${s.id}.svg`} alt={s.gloss} width="64" height="64" loading="lazy" />
          <code>{s.gloss}</code>
          <small>{s.bciAv}</small>
        </li>
      ))
    }
  </ul>

  <div class="more">
    <button type="button" id="bliss-more">Show more</button>
    <noscript>
      <p>
        Showing the first {PAGE_SIZE} of {symbols.length.toLocaleString()} symbols. Searching and
        paging through the rest needs JavaScript.
      </p>
    </noscript>
  </div>
</div>

<style>
  .controls {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .controls input[type='search'] {
    flex: 1 1 16rem;
    padding: 0.4rem 0.6rem;
  }
  .count {
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: 0.75rem;
  }
  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    text-align: center;
  }
  .cell img {
    background: #fff;
    border-radius: 0.2rem;
  }
  .cell code {
    font-size: 0.7rem;
    word-break: break-word;
  }
  .cell small {
    font-size: 0.65rem;
    opacity: 0.6;
  }
  .more {
    margin-top: 1.5rem;
    text-align: center;
  }
  .more button {
    padding: 0.5rem 1.2rem;
    cursor: pointer;
  }
  .more button[hidden] {
    display: none;
  }
</style>

<script>
  type Entry = { i: string; g: string; n: string; p: string; s: string };

  const root = document.querySelector<HTMLElement>('.bliss-gallery');
  const grid = document.getElementById('bliss-grid');
  const filter = document.getElementById('bliss-filter') as HTMLInputElement | null;
  const pos = document.getElementById('bliss-pos') as HTMLSelectElement | null;
  const count = document.getElementById('bliss-count');
  const more = document.getElementById('bliss-more') as HTMLButtonElement | null;

  if (root && grid && more) {
    const base = root.dataset.base ?? '';
    const pageSize = Number(root.dataset.pageSize ?? 200);

    let all: Entry[] = [];
    let matches: Entry[] = [];
    let shown = 0;

    const cell = (e: Entry): string =>
      `<li class="cell">` +
      `<img src="${base}/symbols/${e.i}.svg" alt="${e.g}" width="64" height="64" loading="lazy">` +
      `<code>${e.g}</code><small>${e.n}</small></li>`;

    const renderNextBatch = () => {
      const batch = matches.slice(shown, shown + pageSize);
      grid.insertAdjacentHTML('beforeend', batch.map(cell).join(''));
      shown += batch.length;
      more.hidden = shown >= matches.length;
      if (count) {
        count.textContent =
          matches.length === all.length
            ? `${all.length.toLocaleString()} symbols`
            : `${matches.length.toLocaleString()} of ${all.length.toLocaleString()} match`;
      }
    };

    const apply = () => {
      const q = (filter?.value ?? '').trim().toLowerCase();
      const p = pos?.value ?? '';
      matches = all.filter((e) => (!q || e.s.includes(q)) && (!p || e.p === p));
      // Replacing the grid wholesale keeps the DOM at one page of cells rather
      // than hiding thousands of them.
      grid.textContent = '';
      shown = 0;
      renderNextBatch();
    };

    more.addEventListener('click', renderNextBatch);

    // Appending on scroll as well as on click, so the button is a fallback
    // rather than the only way through 6,551 symbols.
    const sentinel = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting) && !more.hidden) renderNextBatch();
    });
    sentinel.observe(more);

    fetch(`${base}/symbol-index.json`)
      .then((res) => res.json() as Promise<Entry[]>)
      .then((data) => {
        all = data;
        matches = data;
        shown = Math.min(pageSize, data.length);
        more.hidden = shown >= data.length;
        filter?.addEventListener('input', apply);
        pos?.addEventListener('change', apply);
      })
      .catch(() => {
        // The server-rendered first page stays usable; just no search or paging.
        more.hidden = true;
      });
  }
</script>
