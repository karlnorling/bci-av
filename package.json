{
  "name": "bci-av",
  "version": "0.0.0",
  "private": true,
  "description": "Blissymbolics — the BCI Authorized Vocabulary as typed SVG packages for React, Vue 3, Web Components and plain TypeScript",
  "homepage": "https://github.com/karlnorling/bci-av",
  "license": "MIT",
  "author": "Karl Norling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlnorling/bci-av.git"
  },
  "workspaces": [
    "apps/*",
    "packages/@bci-av/*"
  ],
  "scripts": {
    "audit-actions": "node scripts/audit-action-inputs.mjs",
    "build-docs": "yarn workspace @bci-av-docs/app build",
    "changeset": "changeset",
    "check": "manypkg check",
    "check-esm": "node scripts/check-esm.mjs",
    "compile": "yarn workspaces foreach -A --topological-dev run compile",
    "dependabot-sweep": "bash scripts/dependabot-sweep.sh",
    "docs": "yarn workspace @bci-av-docs/app dev",
    "fetch": "tsx bin/fetch-upstream.ts",
    "format": "oxfmt --write --ignore-path=.oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path=.oxfmtignore .",
    "generate": "tsx bin/generate-source.ts",
    "generate-assets": "tsx bin/generate-assets.ts",
    "lint": "oxlint .",
    "prepare": "lefthook install",
    "publish": "yarn changeset publish",
    "test": "yarn workspaces foreach -A run test",
    "type-check": "yarn workspaces foreach -A --include '@bci-av/*' run type-check",
    "type-check:bin": "tsc --noEmit -p tsconfig.bin.json",
    "update": "yarn fetch && yarn generate && yarn generate-assets",
    "version-packages": "changeset version && yarn install --mode=update-lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@manypkg/cli": "^0.25.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.42.0",
    "svgo": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">= 24.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
